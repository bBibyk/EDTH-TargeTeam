RBP_HOST=127.0.0.1
RBP_BIND_HOST=0.0.0.0
PC_HOST=127.0.0.1

CONTROL_PORT=9200
VIDEO_RTP_PORT=9100
AUDIO_RTP_PORT=9102

VIDEO_DEVICE=/dev/video0
AUDIO_DEVICE=default
VIDEO_INPUT_FORMAT=v4l2
AUDIO_INPUT_FORMAT=pulse
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FPS=15
AUDIO_RATE=16000
AUDIO_CHANNELS=1

FFMPEG_BIN=ffmpeg
VIDEO_CODEC=libx264
AUDIO_CODEC=libopus
AUDIO_BITRATE=32k

UI_REFRESH_SECONDS=0.1
STREAM_STALE_SECONDS=2.0
SDP_WAIT_SECONDS=10.0
CONTROL_TIMEOUT_SECONDS=2.0
