RBP_HOST=127.0.0.1
RBP_BIND_HOST=0.0.0.0
PC_HOST=127.0.0.1
PC_PUBLIC_HOST=127.0.0.1

CONTROL_PORT=9200
VIDEO_RTP_PORT=9100
AUDIO_RTP_PORT=9102
VIDEO_HTTP_PORT=8080

VIDEO_DEVICE=/dev/video4
AUDIO_DEVICE=default
# Pi microphone for run_rbp.sh: pulse / alsa (uses AUDIO_DEVICE), or stm32 = STM32 board over USB
# (stm32/mic_stream firmware; uses STM32_MIC_PORT / STM32_MIC_BAUD below)
AUDIO_INPUT_FORMAT=pulse
# VIDEO_WIDTH=1920  # camera max resolution
# VIDEO_HEIGHT=1080
VIDEO_WIDTH=640    # current webcam resolution
VIDEO_HEIGHT=480
VIDEO_FPS=30
AUDIO_RATE=16000
AUDIO_CHANNELS=1

GST_JITTERBUFFER_MS=50
JPEG_QUALITY=70
X264_BITRATE_KBPS=2500
OPUS_BITRATE=32000
CAMERA_FORCE_FPS=1

UI_REFRESH_SECONDS=0.1
STREAM_STALE_SECONDS=2.0
CONTROL_TIMEOUT_SECONDS=2.0

WAKE_HOST=127.0.0.1
WAKE_BIND_HOST=127.0.0.1
WAKE_PORT=9300
WAKE_HOLD_SECONDS=10.0
# run_audio_wake.sh only: folder with the .onnx + mel_basis.npy (EfficientAT, 32 kHz, 2 s).
AUDIO_WAKE_MODEL_PATH=models/audio/raspberry_pi
# Classes that count as wake, comma separated: background,vehicle,drone,footsteps
AUDIO_WAKE_CLASSES=drone
# Mic for run_audio_wake.sh: empty = system default, or stm32 for the STM32 board
AUDIO_WAKE_DEVICE=
# STM32 board serial port (empty = auto-detect the ST-LINK) and baud rate of stm32/mic_stream.
# Only one program can read the board at a time.
STM32_MIC_PORT=
STM32_MIC_BAUD=1000000
# Only used by a model without a fixed window (EfficientAT always uses 2 s).
AUDIO_WAKE_WINDOW_SECONDS=5.0
AUDIO_WAKE_HOP_SECONDS=0.5
AUDIO_WAKE_THRESHOLD=
YOLO_IMGSZ=640
YOLO_CONF=0.25
DETECTOR_SOURCE=/dev/video4

DETECTION_PORT=9201
YOLO_MODEL_PATH=models/vision/yolo26n.pt
YOLO_CONFIDENCE=0.4
YOLO_IOU=0.5
YOLO_MAX_DET=20
YOLO_DEVICE=cpu
YOLO_FRAME_INTERVAL=3

# Audio model inside run_rbp.sh (results -> PC web app on AUDIO_RESULT_PORT). Video + YOLO start when
# vehicle/drone/footsteps >= AUDIO_VEHICLE_PROB_THRESHOLD and stop VIDEO_WAKE_HOLD_SECONDS later.
AUDIO_RESULT_PORT=9202
AUDIO_EVENT_MODEL_PATH=models/audio/raspberry_pi/efficientat_audio_v1.onnx
AUDIO_EVENT_MEL_BASIS_PATH=models/audio/raspberry_pi/mel_basis.npy
# The model only runs on chunks louder than this RMS (0.03 = -30 dBFS)
AUDIO_RMS_WAKE_THRESHOLD=0.03
AUDIO_VEHICLE_PROB_THRESHOLD=0.5
VIDEO_WAKE_HOLD_SECONDS=10.0
